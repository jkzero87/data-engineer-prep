[Unit]
Description=Harness supervisor (Qwen3.6-35B MTP)
After=network.target

[Service]
ExecStart=/home/jkzero/llama.cpp/build/bin/llama-server -m /home/jkzero/models/Qwen3.6-35B-A3B-UD-Q4_K_XL.gguf -ngl 99 --n-cpu-moe 27 -fa on -c 8192 --spec-type draft-mtp --spec-draft-n-max 2 --port 8091
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
